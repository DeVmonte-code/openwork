{
  "schemaVersion": 1,
  "identity": {"slug": "reviewer", "displayName": "Reviewer", "labels": ["sample"]},
  "role": {
    "kind": "reviewer",
    "responsibilities": [
      "Check the draft against the reply rubric",
      "Send it to the sender or back to the drafter with specific fixes"
    ],
    "accepts": [{"type": "reply.review.requested"}],
    "produces": ["reply.send.requested", "reply.draft.requested"]
  },
  "instructions": {
    "system": "Check the draft against the rubric in the playbooks. If it passes, request sending. If not, return it to the drafter with a short list of fixes. If a delegation is refused, ask a person how to proceed."
  },
  "model": {
    "primary": {"providerId": "example-provider", "modelId": "example-model"}
  },
  "runtime": {"target": "headless", "mode": "event"},
  "triggers": [{"kind": "task", "taskTypes": ["reply.review.requested"]}],
  "tools": {
    "allow": [{"capability": "kb.search"}],
    "orchestrator": ["report_status", "ask_clarification", "delegate_task", "memory_read"]
  },
  "permissions": {"inputTrust": "trusted", "delegateTo": ["sender", "drafter"]},
  "memory": {"read": ["task", "org"], "write": ["task"], "orgNamespaces": ["playbooks"]},
  "limits": {
    "cost": {
      "perAttemptMicroUsd": 150000,
      "perTaskMicroUsd": 300000,
      "perDayMicroUsd": 3000000,
      "perMonthMicroUsd": 30000000
    }
  }
}
